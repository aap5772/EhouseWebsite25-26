                    16,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "Qnq0K",
                      "name": "aboutP1",
                      "fill": "#ebf2facc",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We're a tight-knit community that supports each other academically and personally. Whether you need help studying for an exam, want feedback on a project, or just need someone to grab dinner with — there's always someone around.",
                      "lineHeight": 1.375,
                      "fontFamily": "Alexandria",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "letterSpacing": 0.32
                    },
                    {
                      "type": "text",
                      "id": "qSuAu",
                      "name": "aboutP2",
                      "fill": "#ebf2facc",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From beach days and ski trips to hackathons and formal dinners, Engineering House offers a full spectrum of experiences that create lasting friendships and memories throughout your time at RIT.",
                      "lineHeight": 1.375,
                      "fontFamily": "Alexandria",
                      "fontSize": 16,
                      "fontWeight": "normal",
