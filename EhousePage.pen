                      "name": "pj1Title",
                      "fill": "#ebf2fa",
                      "content": "RC Plane",
                      "fontFamily": "Horizon",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "WWQyM",
                      "name": "pj1Members",
                      "fill": "#2775e3ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Project Lead - Alex Polo & Adam Riely",
                      "fontFamily": "Horizon",
                      "fontSize": 13,
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "61Npq",
                      "name": "pj1Desc",
                      "fill": "#ebf2fa",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An in-house, fully 3D-printed RC aircraft created as a student engineering project. The design highlights how aerodynamic structure and electronic control systems integrate into a functional platform. Developed to practice CAD, fabrication, and iterative testing.",
                      "lineHeight": 1.7,
                      "fontFamily": "Alexandria",
                      "fontSize": 15,
                      "fontWeight": "normal",
                      "letterSpacing": 0.32
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "FS8cu",
