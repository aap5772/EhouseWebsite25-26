                    "author": "Jim Luo"
                  },
                  "clip": true,
                  "width": "fill_container",
                  "height": 400,
                  "fill": {
                    "type": "image",
                    "enabled": true,
                    "url": "https://images.unsplash.com/photo-1762291495465-2cc587c180e2?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w4NDM0ODN8MHwxfHJhbmRvbXx8fHx8fHx8fDE3NzE2MDk0ODl8&ixlib=rb-4.1.0&q=80&w=1080",
                    "mode": "fill"
                  },
                  "cornerRadius": 16
                },
                {
                  "type": "frame",
                  "id": "dtAJO",
                  "name": "AboutRight",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 24,
                  "padding": [
                    16,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "48iXh",
                      "name": "aboutP1",
                      "fill": "#091820cc",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We're a tight-knit community that supports each other academically and personally. Whether you need help studying for an exam, want feedback on a project, or just need someone to grab dinner with — there's always someone around.",
                      "lineHeight": 1.375,
                      "fontFamily": "Alexandria",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "letterSpacing": 0.32
                    },
                    {
                      "type": "text",
                      "id": "zs088",
                      "name": "aboutP2",
                      "fill": "#091820cc",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From beach days and ski trips to hackathons and formal dinners, Engineering House offers a full spectrum of experiences that create lasting friendships and memories throughout your time at RIT.",
                      "lineHeight": 1.375,
                      "fontFamily": "Alexandria",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "letterSpacing": 0.32
                    }
                  ]
                }
              ]
