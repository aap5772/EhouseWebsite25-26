                  "letterSpacing": 2
                },
                {
                  "type": "text",
                  "id": "7Ejsp",
                  "name": "aboutTitle",
                  "fill": "#091820ff",
                  "content": "We Are Engineering House",
                  "textAlign": "center",
                  "fontFamily": "Horizon",
                  "fontSize": 40,
                  "fontWeight": "800",
                  "letterSpacing": -0.5
                },
                {
                  "type": "text",
                  "id": "5ux0c",
                  "name": "aboutDesc",
                  "fill": "#091820cc",
                  "textGrowth": "fixed-width",
                  "width": 800,
                  "content": "Engineering House is a Special Interest House at RIT focused on collaboration, innovation, and community. Founded in 1971 and located in DSP (formerly NRH), we bring together students who are passionate about engineering, technology, and making things.",
                  "lineHeight": 1.375,
                  "textAlign": "center",
                  "fontFamily": "Alexandria",
                  "fontSize": 17,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "iMhlG",
              "name": "AboutContent",
              "width": "fill_container",
              "gap": 48,
              "children": [
                {
                  "type": "frame",
