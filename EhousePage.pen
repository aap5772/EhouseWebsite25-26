            {
              "type": "text",
              "id": "mk0mM",
              "name": "jankWhatDesc",
              "fill": "#091820cc",
              "textGrowth": "fixed-width",
              "width": 800,
              "content": "Jankathon is a 24-hour build-a-thon focused on bold, scrappy prototypes. It's not about polish — it's about creativity, resourcefulness, and having fun building something from nothing. Teams compete to create the jankiest, most ingenious projects they can.",
              "lineHeight": 1.375,
              "textAlign": "center",
              "fontFamily": "Alexandria",
              "fontSize": 17,
              "fontWeight": "normal",
