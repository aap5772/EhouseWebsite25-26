              "content": "How Do I Join?",
              "fontFamily": "Horizon",
              "fontSize": 36,
              "fontWeight": "800",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "XWhfF",
              "name": "howDesc",
              "fill": "#091820cc",
              "textGrowth": "fixed-width",
              "width": 800,
              "content": "To join Engineering House, apply through your RIT housing contract during room selection. A selection committee reviews all applications. Make sure to list Engineering House as your preference in the RIT Housing application!",
              "lineHeight": 1.375,
              "textAlign": "center",
              "fontFamily": "Alexandria",
              "fontSize": 17,
              "fontWeight": "normal",
              "letterSpacing": 0.32
            },
            {
              "type": "frame",
              "id": "de6qT",
              "name": "howBtn",
              "fill": "#ebf2faff",
