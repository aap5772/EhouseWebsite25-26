            64,
            200
          ],
          "children": [
            {
              "type": "frame",
              "id": "EObB7",
              "name": "q1",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "01UoP",
                  "name": "q1Title",
                  "fill": "#ebf2faff",
                  "content": "What are the benefits of joining Engineering House?",
                  "fontFamily": "Horizon",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "3vXHP",
                  "name": "q1Ans",
                  "fill": "#ebf2facc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Engineering House offers a supportive community of like-minded students, access to workshop spaces, study lounges, social events throughout the year, ImagineRIT project opportunities, and lifelong friendships with fellow engineers.",
                  "lineHeight": 1.7,
                  "fontFamily": "Alexandria",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "rYdFk",
              "name": "q2",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "gCbLd",
                  "name": "q2Title",
                  "fill": "#ebf2faff",
                  "content": "What are the commitment expectations?",
                  "fontFamily": "Horizon",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "XIc7c",
                  "name": "q2Ans",
                  "fill": "#ebf2facc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We expect members to participate in house activities and contribute to the community. This includes attending house meetings, participating in events, and maintaining a positive presence on the floor.",
                  "lineHeight": 1.7,
                  "fontFamily": "Alexandria",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "O3bl9",
              "name": "q3",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "fbqld",
                  "name": "q3Title",
                  "fill": "#ebf2faff",
                  "content": "Is Engineering House one floor? What is it?",
                  "fontFamily": "Horizon",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "KOdtt",
                  "name": "q3Ans",
                  "fill": "#ebf2facc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Engineering House is a Special Interest House (SIH) that occupies one floor in DSP (formerly NRH). It's a living-learning community where students who are passionate about engineering and technology live together.",
                  "lineHeight": 1.7,
                  "fontFamily": "Alexandria",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "otg1k",
              "name": "q4",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "zuwJv",
                  "name": "q4Title",
                  "fill": "#ebf2faff",
                  "content": "What is the off-floor member experience like?",
                  "fontFamily": "Horizon",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "t801U",
                  "name": "q4Ans",
                  "fill": "#ebf2facc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Off-floor members participate in all the same events and have access to the same resources. The recruitment chair helps off-floor members stay connected with the community, and there may be opportunities to move on-floor if spots become available.",
                  "lineHeight": 1.7,
                  "fontFamily": "Alexandria",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "C4EwZ",
              "name": "q5",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "HEBsl",
                  "name": "q5Title",
                  "fill": "#ebf2faff",
                  "content": "What if I already selected a roommate before acceptance?",
                  "fontFamily": "Horizon",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "h4IoB",
                  "name": "q5Ans",
                  "fill": "#ebf2facc",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No worries! You can still join Engineering House. Talk to the recruitment chair about your specific situation and we'll work with you to find the best arrangement.",
                  "lineHeight": 1.7,
                  "fontFamily": "Alexandria",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
              ]
            },
            {
              "type": "frame",
              "id": "OM8g1",
              "name": "q6",
              "width": "fill_container",
              "fill": "#091820ff",
              "cornerRadius": 15,
              "stroke": {
                "thickness": 1,
                "fill": "#024889ff"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 24,
              "children": [
                {
                  "type": "text",
                  "id": "dVWoZ",
                  "name": "q6Title",
