                {
                  "type": "text",
                  "id": "R1ZaM",
                  "name": "featureDesc1",
                  "fill": "#FFFFFFCC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Engineering House provides a unique living and learning experience at RIT. Our members support each other through study sessions, project collaboration, and a shared passion for building things.",
                  "lineHeight": 1.375,
                  "fontFamily": "Alexandria",
                  "fontSize": 16,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                },
                {
                  "type": "text",
                  "id": "ZKpzV",
                  "name": "featureDesc2",
                  "fill": "#FFFFFFCC",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We host events throughout the year — from outdoor adventures and concerts to hackathons and formals. Engineering House isn't just where you live; it's where you find your people.",
                  "lineHeight": 1.375,
                  "fontFamily": "Alexandria",
                  "fontSize": 16,
                  "fontWeight": "normal",
                  "letterSpacing": 0.32
                }
